{
  "compilerOptions": {
    /* === Path alias === */
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    /* === Next.js-friendly settings === */
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": [
      "DOM",
      "ES2022"
    ],
    /* === Common TS options === */
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    /* Optional but nice */
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    /* Next plugin for better DX */
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
